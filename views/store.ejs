<!-- <!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Product Store</title>


<style>

body{

font-family:'Segoe UI',Arial,sans-serif;

background:#f4f6f9;

margin:0;

padding:20px;

}


h1{

text-align:center;

color:#1e3a8a;

margin-bottom:30px;

}



.product-grid{


display:grid;

grid-template-columns:
repeat(auto-fill,minmax(220px,1fr));

gap:20px;

max-width:1200px;

margin:auto;


}



.product-card{


background:white;

border-radius:15px;

padding:15px;

box-shadow:0 5px 15px rgba(0,0,0,.08);

cursor:pointer;

transition:.3s;


}



.product-card:hover{

transform:translateY(-5px);

}



.product-card img{


width:100%;

height:180px;

object-fit:contain;

border-radius:10px;


}




.product-title{


font-size:20px;

font-weight:700;

color:#111827;

margin-top:10px;


}



.product-desc{


font-size:14px;

color:#64748b;

margin-top:8px;

line-height:1.5;


}




.btn-delete{


display:block;

margin-top:15px;

background:#dc2626;

color:white;

text-align:center;

text-decoration:none;

padding:10px;

border-radius:8px;


}



.btn-delete:hover{


background:#991b1b;


}




.status-msg{


text-align:center;

grid-column:1/-1;

}


</style>


</head>


<body>



<h1>
Product Store
</h1>



<div id="product-list" class="product-grid">

<p class="status-msg">
Loading Products...
</p>


</div>




<script>


async function loadProducts(){


const container =
document.getElementById("product-list");



try{


const response =
await fetch("/store/api/products");



const products =
await response.json();





if(products.length===0){


container.innerHTML=
`
<p class="status-msg">
No Products Available
</p>
`;


return;


}




container.innerHTML="";





products.forEach(product=>{


const card =
document.createElement("div");


card.className="product-card";



card.onclick=()=>{


window.location.href =
`/store/product/${product._id}`;


};



card.innerHTML=`

<img 
src="${product.image || 'https://via.placeholder.com/200'}"
onerror="this.src='https://via.placeholder.com/200'"
>



<div class="product-title">

${product.name}

</div>



<div class="product-desc">

${product.description || "Quality Product"}

</div>



<a href="/store/delete-product/${product._id}"
class="btn-delete"
onclick="event.stopPropagation(); return confirm('Delete Product?')">

Delete

</a>


`;



container.appendChild(card);



});




}

catch(err){


console.log(err);


container.innerHTML=
`
<p class="status-msg" style="color:red">

Error Loading Products

</p>
`;

}


}



document.addEventListener(
"DOMContentLoaded",
loadProducts
);



</script>


</body>

</html> -->