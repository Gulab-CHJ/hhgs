
<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>GS Market - Customer Orders</title>
  <link rel="stylesheet" href="/css/store.css">

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      padding: 12px;
      background: #f3f6f4;
      color: #1d3027;
      font-family: Arial, sans-serif;
    }

    .orders-wrap {
      max-width: 1800px;
      margin: auto;
    }

    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      background: #fff;
      border: 1px solid #dfe8e2;
      border-radius: 12px;
      padding: 12px 15px;
      margin-bottom: 12px;
    }

    h1 {
      font-size: 21px;
      margin: 0;
    }

    .toolbar-links {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      font-size: 13px;
    }

    a { color: #176b50; }

    .sound-btn, .refresh-btn {
      border: 0;
      border-radius: 7px;
      padding: 8px 11px;
      cursor: pointer;
      font-weight: bold;
    }

    .sound-btn { background: #176b50; color: white; }
    .refresh-btn { background: #e6eee9; color: #234a38; }

    .summary {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin: 10px 0;
    }

    .summary span {
      background: white;
      border: 1px solid #e0e8e3;
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 13px;
    }

    #newOrderNotice {
      display: none;
      padding: 10px 13px;
      margin: 10px 0;
      border-radius: 9px;
      background: #fff3cd;
      color: #654d00;
      font-weight: bold;
    }

    .orders-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(285px, 1fr));
      gap: 10px;
      align-items: start;
    }

    .order-card {
      min-width: 0;
      background: white;
      border: 1px solid #dce6df;
      border-radius: 11px;
      padding: 12px;
      box-shadow: 0 2px 6px #142b1b0a;
      overflow-wrap: anywhere;
    }

    .order-card.new-order {
      border: 2px solid #e29b13;
      animation: newOrderPulse 1s ease-in-out 3;
    }

    @keyframes newOrderPulse {
      0%, 100% { box-shadow: 0 0 0 0 #f5b82e00; }
      50% { box-shadow: 0 0 0 5px #f5b82e55; }
    }

    .order-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 8px;
    }

    .order-top h2 {
      margin: 0;
      font-size: 15px;
      overflow-wrap: anywhere;
    }

    .order-status {
      display: inline-block;
      padding: 4px 7px;
      border-radius: 6px;
      background: #e9f3ed;
      color: #176b50;
      font-size: 11px;
      font-weight: bold;
      white-space: nowrap;
    }

    .order-meta {
      color: #52645a;
      font-size: 12px;
      line-height: 1.55;
      margin: 9px 0;
    }

    .order-meta strong { color: #203c2d; }

    .order-items {
      margin: 5px 0;
      padding-left: 18px;
      font-size: 12px;
      line-height: 1.6;
    }

    .amounts {
      border-top: 1px solid #edf0ed;
      margin-top: 8px;
      padding-top: 7px;
      font-size: 12px;
      line-height: 1.7;
    }

    .total {
      color: #176b50;
      font-size: 15px;
      font-weight: bold;
    }

    .status-form {
      display: flex;
      gap: 6px;
      margin-top: 10px;
    }

    .status-form select {
      flex: 1;
      min-width: 0;
      padding: 8px 5px;
      border: 1px solid #d5e0d8;
      border-radius: 7px;
      background: white;
      font-size: 12px;
    }

    .status-form button {
      border: 0;
      border-radius: 7px;
      padding: 8px 10px;
      background: #176b50;
      color: white;
      font-weight: bold;
      cursor: pointer;
      font-size: 12px;
    }

    .empty {
      padding: 25px;
      background: white;
      border-radius: 10px;
      text-align: center;
    }

    #lastUpdated {
      color: #66776c;
      font-size: 11px;
    }

    @media (max-width: 600px) {
      body { padding: 7px; }
      .orders-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px; }
      .order-card { padding: 9px; }
      .order-top h2 { font-size: 13px; }
      .order-meta { font-size: 11px; }
      .status-form { flex-direction: column; }
      .status-form button { width: 100%; }
      h1 { font-size: 18px; }
    }

    @media (max-width: 360px) {
      .orders-grid { grid-template-columns: 1fr; }
    }

    @media (prefers-reduced-motion: reduce) {
      .new-order { animation: none !important; }
    }
  </style>
</head>

<body>
<div class="orders-wrap">

  <header class="toolbar">
    <h1>GS Market — Customer Orders</h1>

    <div class="toolbar-links">
      <a href="/admin/market/products">Manage Products</a>
      <a href="/market">Open Store</a>

      <button type="button" class="sound-btn" id="soundToggle">
        🔔 Sound: ON
      </button>

      <button type="button" class="refresh-btn" id="refreshNow">
        ↻ Refresh
      </button>
    </div>
  </header>

  <% if (message) { %>
    <p role="status"><%= message %></p>
  <% } %>

  <div class="summary">
    <span>Total orders: <strong id="totalOrders"><%= orders.length %></strong></span>
    <span>Pending: <strong id="pendingOrders"><%= orders.filter(o => o.orderStatus === "Pending").length %></strong></span>
    <span>Paid: <strong><%= orders.filter(o => o.paymentStatus === "Paid").length %></strong></span>
    <span id="lastUpdated">Page loaded</span>
  </div>

  <div id="newOrderNotice" role="status" aria-live="polite"></div>

  <% if (!orders.length) { %>
    <div class="empty" id="emptyOrders">
      अभी कोई customer order नहीं आया है।
    </div>
  <% } %>

  <main class="orders-grid" id="ordersGrid">
    <% orders.forEach(order => { %>
      <section class="order-card" data-order-id="<%= order._id %>">

        <div class="order-top">
          <h2>Order #<%= order.orderNumber || order._id %></h2>
          <span class="order-status"><%= order.orderStatus %></span>
        </div>

        <div class="order-meta">
          <div>Date: <%= new Date(order.createdAt).toLocaleString("en-IN", { timeZone: "Asia/Kolkata" }) %></div>
          <div>Customer: <strong><%= order.customer?.name || "N/A" %></strong></div>
          <div>Mobile: <%= order.customer?.phone || "N/A" %></div>
          <div>Address: <%= order.customer?.address || "N/A" %></div>
          <div>Payment: <strong><%= order.paymentStatus || "Unknown" %></strong></div>
          <div>Method: <%= order.paymentMethod || "N/A" %></div>
          <div>Payment ID: <%= order.razorpayPaymentId || "Not paid yet" %></div>
        </div>

        <strong style="font-size:12px">Products</strong>
        <ul class="order-items">
          <% (order.items || []).forEach(item => { %>
            <li>
              <%= item.name %> × <%= item.quantity %>
              — ₹<%= Number(item.subtotal || 0).toFixed(2) %>
            </li>
          <% }) %>
        </ul>

        <div class="amounts">
          <div>Subtotal: ₹<%= Number(order.subtotal || 0).toFixed(2) %></div>
          <div>Delivery: ₹<%= Number(order.deliveryCharge || 0).toFixed(2) %></div>
          <div class="total">Total: ₹<%= Number(order.totalAmount || 0).toFixed(2) %></div>
        </div>

        <form class="status-form"
              action="/admin/market/orders/status/<%= order._id %>"
              method="POST">

          <select name="orderStatus" aria-label="Order status">
            <% ["Pending", "Confirmed", "Shipped", "Delivered", "Cancelled"].forEach(status => { %>
              <option value="<%= status %>"
                <%= order.orderStatus === status ? "selected" : "" %>>
                <%= status %>
              </option>
            <% }) %>
          </select>

          <button type="submit">Update Status</button>
        </form>

      </section>
    <% }) %>
  </main>
</div>

<script>
(() => {
  "use strict";

  const REFRESH_MS = 5000;
  const SOUND_KEY = "hhgs_market_order_sound_enabled_v1";
  const SEEN_KEY = "hhgs_market_seen_order_ids_v1";

  const soundButton = document.getElementById("soundToggle");
  const refreshButton = document.getElementById("refreshNow");
  const grid = document.getElementById("ordersGrid");
  const notice = document.getElementById("newOrderNotice");
  const lastUpdated = document.getElementById("lastUpdated");

  let soundEnabled = localStorage.getItem(SOUND_KEY) !== "false";
  let audioContext = null;
  let refreshing = false;
  let knownIds = new Set(
    Array.from(grid.querySelectorAll("[data-order-id]"))
      .map(card => card.dataset.orderId)
  );

  function getSeenIds() {
    try {
      return new Set(JSON.parse(sessionStorage.getItem(SEEN_KEY) || "[]"));
    } catch {
      return new Set();
    }
  }

  let seenIds = getSeenIds();

  // Initial page orders are existing orders, not new notifications.
  knownIds.forEach(id => seenIds.add(id));
  saveSeenIds();

  function saveSeenIds() {
    try {
      sessionStorage.setItem(SEEN_KEY, JSON.stringify([...seenIds].slice(-1000)));
    } catch {}
  }

  function updateSoundButton() {
    soundButton.textContent = soundEnabled ? "🔔 Sound: ON" : "🔕 Sound: OFF";
    soundButton.setAttribute("aria-pressed", String(soundEnabled));
  }

  async function enableAudio() {
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (!AudioCtx) return false;

    try {
      if (!audioContext) audioContext = new AudioCtx();
      if (audioContext.state === "suspended") await audioContext.resume();
      return audioContext.state === "running";
    } catch {
      return false;
    }
  }

  async function ringOnce() {
    if (!soundEnabled) return;

    const ready = await enableAudio();
    if (!ready) {
      notice.textContent =
        "नया order आया है। Sound के लिए इस पेज पर एक बार click करें।";
      notice.style.display = "block";
      return;
    }

    try {
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();

      oscillator.type = "sine";
      oscillator.frequency.setValueAtTime(880, audioContext.currentTime);
      oscillator.frequency.setValueAtTime(660, audioContext.currentTime + 0.18);

      gain.gain.setValueAtTime(0.0001, audioContext.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.18, audioContext.currentTime + 0.03);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioContext.currentTime + 0.45);

      oscillator.connect(gain);
      gain.connect(audioContext.destination);
      oscillator.start();
      oscillator.stop(audioContext.currentTime + 0.46);
    } catch (error) {
      console.warn("Order notification sound unavailable:", error);
    }
  }

  soundButton.addEventListener("click", async () => {
    soundEnabled = !soundEnabled;
    localStorage.setItem(SOUND_KEY, String(soundEnabled));
    updateSoundButton();

    if (soundEnabled) {
      await enableAudio();
      await ringOnce();
    }
  });

  // A user click can unlock browser audio after refresh.
  document.addEventListener("click", () => {
    if (soundEnabled && !audioContext) enableAudio();
  }, { once: true });

  refreshButton.addEventListener("click", () => refreshOrders(true));

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, char => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    })[char]);
  }

  function money(value) {
    const number = Number(value || 0);
    return Number.isFinite(number) ? number.toFixed(2) : "0.00";
  }

  function dateText(value) {
    const date = new Date(value);
    return Number.isNaN(date.getTime())
      ? "N/A"
      : date.toLocaleString("en-IN", { timeZone: "Asia/Kolkata" });
  }

  function renderOrder(order, isNew) {
    const id = escapeHtml(order._id);
    const orderNumber = escapeHtml(order.orderNumber || order._id);
    const customer = order.customer || {};
    const statuses = ["Pending", "Confirmed", "Shipped", "Delivered", "Cancelled"];
    const items = Array.isArray(order.items) ? order.items : [];

    const itemHtml = items.map(item =>
      `<li>${escapeHtml(item.name)} × ${escapeHtml(item.quantity)} — ₹${money(item.subtotal)}</li>`
    ).join("");

    const options = statuses.map(status =>
      `<option value="${status}" ${order.orderStatus === status ? "selected" : ""}>${status}</option>`
    ).join("");

    return `
      <section class="order-card ${isNew ? "new-order" : ""}" data-order-id="${id}">
        <div class="order-top">
          <h2>Order #${orderNumber}</h2>
          <span class="order-status">${escapeHtml(order.orderStatus || "Pending")}</span>
        </div>
        <div class="order-meta">
          <div>Date: ${escapeHtml(dateText(order.createdAt))}</div>
          <div>Customer: <strong>${escapeHtml(customer.name || "N/A")}</strong></div>
          <div>Mobile: ${escapeHtml(customer.phone || "N/A")}</div>
          <div>Address: ${escapeHtml(customer.address || "N/A")}</div>
          <div>Payment: <strong>${escapeHtml(order.paymentStatus || "Unknown")}</strong></div>
          <div>Method: ${escapeHtml(order.paymentMethod || "N/A")}</div>
          <div>Payment ID: ${escapeHtml(order.razorpayPaymentId || "Not paid yet")}</div>
        </div>
        <strong style="font-size:12px">Products</strong>
        <ul class="order-items">${itemHtml}</ul>
        <div class="amounts">
          <div>Subtotal: ₹${money(order.subtotal)}</div>
          <div>Delivery: ₹${money(order.deliveryCharge)}</div>
          <div class="total">Total: ₹${money(order.totalAmount)}</div>
        </div>
        <form class="status-form" action="/admin/market/orders/status/${id}" method="POST">
          <select name="orderStatus" aria-label="Order status">${options}</select>
          <button type="submit">Update Status</button>
        </form>
      </section>`;
  }

  async function refreshOrders(manual = false) {
    if (refreshing) return;
    refreshing = true;

    try {
      const response = await fetch("/admin/market/orders/data", {
        method: "GET",
        cache: "no-store",
        headers: { "Accept": "application/json" }
      });

      if (!response.ok) throw new Error("Orders API returned " + response.status);

      const data = await response.json();
      if (!data.success || !Array.isArray(data.orders)) {
        throw new Error("Invalid orders response");
      }

      const orders = data.orders;
      const currentIds = new Set(orders.map(order => String(order._id)));
      const newOrders = orders.filter(order => {
        const id = String(order._id);
        return !knownIds.has(id) && !seenIds.has(id);
      });

      // Re-render cards, preserving existing status forms and URLs.
      grid.innerHTML = orders.map(order => {
        const id = String(order._id);
        return renderOrder(order, newOrders.some(item => String(item._id) === id));
      }).join("");

      document.getElementById("totalOrders").textContent = String(orders.length);
      document.getElementById("pendingOrders").textContent =
        String(orders.filter(order => order.orderStatus === "Pending").length);

      const empty = document.getElementById("emptyOrders");
      if (empty) empty.style.display = orders.length ? "none" : "block";

      if (newOrders.length) {
        newOrders.forEach(order => seenIds.add(String(order._id)));
        saveSeenIds();

        notice.textContent = `🔔 ${newOrders.length} नया Market order आया है!`;
        notice.style.display = "block";
        await ringOnce();
      } else if (manual) {
        notice.textContent = "Orders refresh हो गए। कोई नया order नहीं है।";
        notice.style.display = "block";
      }

      knownIds = currentIds;
      lastUpdated.textContent = "Last checked: " +
        new Date().toLocaleTimeString("en-IN");

    } catch (error) {
      console.error("Market order auto-refresh error:", error);
      lastUpdated.textContent = "Refresh failed — retrying";
    } finally {
      refreshing = false;
    }
  }

  updateSoundButton();

  // Poll every five seconds. Existing orders are not rung on page load.
  setInterval(() => refreshOrders(false), REFRESH_MS);
  lastUpdated.textContent = "Auto-refresh: हर 5 सेकंड";
})();
</script>
</body>
</html>
